{
  "name": "Stellar Agents",
  "version": "0.1.2",
  "group": "constellation",
  "guide": ".agents/guide",
  "runtime": {
    "runner": "scripts/newsroom.py",
    "gate": "scripts/copydesk.py",
    "hooks": "scripts/hooks",
    "settings": "newsroom/.claude/settings.json",
    "evals": "scripts/eval.py"
  },
  "tools": [
    {
      "key": "claude",
      "label": "Claude Code",
      "global": "~/.claude/skills/ and ~/.claude/agents/",
      "native": "/plugin marketplace add ., then /plugin install constellation@stellar-agents",
      "page": "integrations/claude-code"
    },
    {
      "key": "codex",
      "label": "Codex",
      "global": "~/.agents/skills/",
      "native": "npx skills add . --agent codex",
      "page": "integrations/codex"
    },
    {
      "key": "gemini",
      "label": "Gemini CLI",
      "global": "~/.gemini/skills/",
      "native": "gemini skills install ./.agents/<star>",
      "page": "integrations/gemini-cli"
    },
    {
      "key": "openclaw",
      "label": "OpenClaw",
      "global": "~/.agents/skills/",
      "native": "openclaw skills install ./.agents/<star> --as <id>",
      "page": "integrations/openclaw"
    },
    {
      "key": "hermes",
      "label": "Hermes",
      "global": "~/.hermes/skills/constellation/",
      "native": "node scripts/install.js --tools hermes",
      "page": "integrations/hermes"
    }
  ],
  "stars": [
    {
      "id": "draco-chief-of-staff",
      "star": "draco",
      "path": ".agents/draco",
      "tier": "core",
      "role": "chief_of_staff",
      "cadence": "daily 07:00",
      "tools": [
        "Read",
        "Glob",
        "Grep",
        "Write"
      ],
      "write_zones": [
        "Daily/"
      ],
      "receives_from": [
        "owner",
        "carina-managing-editor",
        "alcyone-scheduler",
        "mira-ombudsman"
      ],
      "hands_to": [
        "owner"
      ],
      "skills": [
        "morning-brief"
      ],
      "free_skills": [
        "morning-brief"
      ]
    },
    {
      "id": "carina-managing-editor",
      "star": "carina",
      "path": ".agents/carina",
      "tier": "core",
      "role": "managing_editor",
      "cadence": "Mon 06:15",
      "tools": [
        "Read",
        "Glob",
        "Grep",
        "Write"
      ],
      "write_zones": [
        "outputs/plan/",
        "governance/proposals/"
      ],
      "receives_from": [
        "owner",
        "aurora-reporter",
        "mira-ombudsman"
